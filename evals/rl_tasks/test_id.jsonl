{"name": "is_between_minus_5_0", "args": "x", "doc": "Return True if x is between -5 and 0 inclusive, otherwise False.", "tests": ["assert is_between_minus_5_0(-5) == True", "assert is_between_minus_5_0(0) == True", "assert is_between_minus_5_0(1) == False", "assert is_between_minus_5_0(-9) == False", "assert is_between_minus_5_0(-14) == False"], "reference": "    return -5 <= x <= 0\n"}
{"name": "clamp_minus_5_0", "args": "x", "doc": "Return x limited to the range -5 to 0: smaller values become -5, larger values become 0.", "tests": ["assert clamp_minus_5_0(-9) == -5", "assert clamp_minus_5_0(-17) == -5", "assert clamp_minus_5_0(3) == 0", "assert clamp_minus_5_0(14) == 0", "assert clamp_minus_5_0(9) == 0"], "reference": "    return max(-5, min(0, x))\n"}
{"name": "clamp_3_8", "args": "x", "doc": "Return x limited to the range 3 to 8: smaller values become 3, larger values become 8.", "tests": ["assert clamp_3_8(-12) == 3", "assert clamp_3_8(6) == 6", "assert clamp_3_8(-6) == 3", "assert clamp_3_8(-4) == 3", "assert clamp_3_8(15) == 8"], "reference": "    return max(3, min(8, x))\n"}
{"name": "is_between_10_30", "args": "x", "doc": "Return True if x is between 10 and 30 inclusive, otherwise False.", "tests": ["assert is_between_10_30(10) == True", "assert is_between_10_30(30) == True", "assert is_between_10_30(31) == False", "assert is_between_10_30(8) == False", "assert is_between_10_30(9) == False"], "reference": "    return 10 <= x <= 30\n"}
{"name": "power_5", "args": "x", "doc": "Return x raised to the power 5.", "tests": ["assert power_5(-2) == -32", "assert power_5(-1) == -1", "assert power_5(6) == 7776", "assert power_5(-8) == -32768", "assert power_5(0) == 0"], "reference": "    return x ** 5\n"}
{"name": "keep_greater_than_minus_5", "args": "xs", "doc": "Return a list of the numbers in xs that are greater than -5, in their original order.", "tests": ["assert keep_greater_than_minus_5([15, -12, -7, -12, -8]) == [15]", "assert keep_greater_than_minus_5([-8, 5, -9, -7, -9, -1]) == [5, -1]", "assert keep_greater_than_minus_5([]) == []", "assert keep_greater_than_minus_5([-14]) == []", "assert keep_greater_than_minus_5([0, -4, -10, -3, 13, 10, 15, 5]) == [0, -4, -3, 13, 10, 15, 5]"], "reference": "    return [x for x in xs if x > -5]\n"}
{"name": "remove_all_minus_5", "args": "xs", "doc": "Return a new list with every occurrence of -5 removed from xs.", "tests": ["assert remove_all_minus_5([-5, 1, -6, -5, -5, -5, 8]) == [1, -6, 8]", "assert remove_all_minus_5([-5, -5, -5, -7, -5, 2]) == [-7, 2]", "assert remove_all_minus_5([-5, 11, -5, -5, -5]) == [11]", "assert remove_all_minus_5([-5, 8, -6, -5, -5, -5, -5]) == [8, -6]", "assert remove_all_minus_5([4, -8, -5, -5, -8]) == [4, -8, -8]"], "reference": "    return [x for x in xs if x != -5]\n"}
{"name": "count_greater_than_minus_3", "args": "xs", "doc": "Return how many numbers in the list xs are greater than -3.", "tests": ["assert count_greater_than_minus_3([10, -10, 3, -15, 6, 12, 4, 10]) == 6", "assert count_greater_than_minus_3([-15, 1]) == 1", "assert count_greater_than_minus_3([7, 8]) == 2", "assert count_greater_than_minus_3([-11, 5, -11, -15]) == 1", "assert count_greater_than_minus_3([-11, -3, -10, 1]) == 1"], "reference": "    return sum(1 for x in xs if x > -3)\n"}
{"name": "remove_all_minus_3", "args": "xs", "doc": "Return a new list with every occurrence of -3 removed from xs.", "tests": ["assert remove_all_minus_3([-3, -3, -2, -3, -3]) == [-2]", "assert remove_all_minus_3([-3]) == []", "assert remove_all_minus_3([-1, -3, -3]) == [-1]", "assert remove_all_minus_3([-3, 11, -3, -3, -3, -3, -3, -3]) == [11]", "assert remove_all_minus_3([-3, -3, -3]) == []"], "reference": "    return [x for x in xs if x != -3]\n"}
{"name": "count_greater_than_minus_2", "args": "xs", "doc": "Return how many numbers in the list xs are greater than -2.", "tests": ["assert count_greater_than_minus_2([11, -10, -15, -4, 7]) == 2", "assert count_greater_than_minus_2([-13]) == 0", "assert count_greater_than_minus_2([2, 13, -11, 4]) == 3", "assert count_greater_than_minus_2([11, -12, 10, 1]) == 3", "assert count_greater_than_minus_2([-6, -12, 3]) == 1"], "reference": "    return sum(1 for x in xs if x > -2)\n"}
{"name": "remove_all_minus_2", "args": "xs", "doc": "Return a new list with every occurrence of -2 removed from xs.", "tests": ["assert remove_all_minus_2([-2, -2, -2, 6, -2]) == [6]", "assert remove_all_minus_2([-2, -2, -8, -2, -2, -2]) == [-8]", "assert remove_all_minus_2([-2, -2, -2, 5]) == [5]", "assert remove_all_minus_2([-2, 4, -2]) == [4]", "assert remove_all_minus_2([4, -2, -2, 5, 1]) == [4, 5, 1]"], "reference": "    return [x for x in xs if x != -2]\n"}
{"name": "remove_all_minus_1", "args": "xs", "doc": "Return a new list with every occurrence of -1 removed from xs.", "tests": ["assert remove_all_minus_1([-1]) == []", "assert remove_all_minus_1([-1, -1, -1]) == []", "assert remove_all_minus_1([-8, -4, -1, -4, -1]) == [-8, -4, -4]", "assert remove_all_minus_1([-1, -1, -1, 10, -1, -1, -1]) == [10]", "assert remove_all_minus_1([-1, -1, 5, -1]) == [5]"], "reference": "    return [x for x in xs if x != -1]\n"}
{"name": "count_less_than_2", "args": "xs", "doc": "Return how many numbers in the list xs are less than 2.", "tests": ["assert count_less_than_2([1, 13, 14, -9]) == 2", "assert count_less_than_2([5, -7, -14, 11, -9, -11]) == 4", "assert count_less_than_2([]) == 0", "assert count_less_than_2([3]) == 0", "assert count_less_than_2([-1]) == 1"], "reference": "    return sum(1 for x in xs if x < 2)\n"}
{"name": "remove_all_2", "args": "xs", "doc": "Return a new list with every occurrence of 2 removed from xs.", "tests": ["assert remove_all_2([2, -4]) == [-4]", "assert remove_all_2([2, 2, 2, 2, 2, -7, 2]) == [-7]", "assert remove_all_2([2, 2]) == []", "assert remove_all_2([2]) == []", "assert remove_all_2([2, -6, -2]) == [-6, -2]"], "reference": "    return [x for x in xs if x != 2]\n"}
{"name": "remove_all_3", "args": "xs", "doc": "Return a new list with every occurrence of 3 removed from xs.", "tests": ["assert remove_all_3([-5, 3, 3, 3, 3, 3]) == [-5]", "assert remove_all_3([3, 3, 3, 11]) == [11]", "assert remove_all_3([3, 3, 3, 11, 3]) == [11]", "assert remove_all_3([]) == []", "assert remove_all_3([3, 3, 3]) == []"], "reference": "    return [x for x in xs if x != 3]\n"}
{"name": "count_greater_than_5", "args": "xs", "doc": "Return how many numbers in the list xs are greater than 5.", "tests": ["assert count_greater_than_5([-7, 8, -1, -7, -12]) == 1", "assert count_greater_than_5([-6, 0, 0, 6, -9]) == 1", "assert count_greater_than_5([5, -9, -1]) == 0", "assert count_greater_than_5([9, 6, 9, -8]) == 3", "assert count_greater_than_5([15, 6, -3, 6, 11, -9]) == 4"], "reference": "    return sum(1 for x in xs if x > 5)\n"}
{"name": "keep_greater_than_5", "args": "xs", "doc": "Return a list of the numbers in xs that are greater than 5, in their original order.", "tests": ["assert keep_greater_than_5([-4]) == []", "assert keep_greater_than_5([-10, -12, -2]) == []", "assert keep_greater_than_5([0, -15, -1, 1, 7, 9, -6, -7]) == [7, 9]", "assert keep_greater_than_5([11, 5, 8]) == [11, 8]", "assert keep_greater_than_5([-1]) == []"], "reference": "    return [x for x in xs if x > 5]\n"}
{"name": "keep_greater_than_6", "args": "xs", "doc": "Return a list of the numbers in xs that are greater than 6, in their original order.", "tests": ["assert keep_greater_than_6([7, -10, -6, 3, -10, -12]) == [7]", "assert keep_greater_than_6([10, 5, -15, -1, 2, 13, 1]) == [10, 13]", "assert keep_greater_than_6([-6, -5, 8, -7, 3, 6, 11]) == [8, 11]", "assert keep_greater_than_6([2, 6]) == []", "assert keep_greater_than_6([7, -5, -11, -11]) == [7]"], "reference": "    return [x for x in xs if x > 6]\n"}
{"name": "remove_all_6", "args": "xs", "doc": "Return a new list with every occurrence of 6 removed from xs.", "tests": ["assert remove_all_6([6, 6, 6, 6, 6, 12, 6, 6]) == [12]", "assert remove_all_6([6, 6, -7, 6, 6, 6, 6, -7]) == [-7, -7]", "assert remove_all_6([6, 6, 6]) == []", "assert remove_all_6([6]) == []", "assert remove_all_6([6, 9, 7, 6, 6, 6, 6]) == [9, 7]"], "reference": "    return [x for x in xs if x != 6]\n"}
{"name": "count_greater_than_7", "args": "xs", "doc": "Return how many numbers in the list xs are greater than 7.", "tests": ["assert count_greater_than_7([-12, -7, 9, 9, -6, 12, -9, -9]) == 3", "assert count_greater_than_7([-3, 10, 12, -15, -14, -13, 13]) == 3", "assert count_greater_than_7([-13, -10]) == 0", "assert count_greater_than_7([]) == 0", "assert count_greater_than_7([-3, 13, -2, -12, -11, 11]) == 2"], "reference": "    return sum(1 for x in xs if x > 7)\n"}
{"name": "keep_greater_than_7", "args": "xs", "doc": "Return a list of the numbers in xs that are greater than 7, in their original order.", "tests": ["assert keep_greater_than_7([-13, -11, 15, 13, -2, -4]) == [15, 13]", "assert keep_greater_than_7([-7, 3]) == []", "assert keep_greater_than_7([-9]) == []", "assert keep_greater_than_7([-12, -12, -7, 7, 7, -3, 6, 13]) == [13]", "assert keep_greater_than_7([-14, -9]) == []"], "reference": "    return [x for x in xs if x > 7]\n"}
{"name": "remove_all_8", "args": "xs", "doc": "Return a new list with every occurrence of 8 removed from xs.", "tests": ["assert remove_all_8([8, 8, 8, 8, -4, 8, 8]) == [-4]", "assert remove_all_8([]) == []", "assert remove_all_8([8, 8, 8, -8, 8, 3, 8, 8]) == [-8, 3]", "assert remove_all_8([8]) == []", "assert remove_all_8([8, 8, 1, 2, 8, 8, 8]) == [1, 2]"], "reference": "    return [x for x in xs if x != 8]\n"}
{"name": "keep_greater_than_9", "args": "xs", "doc": "Return a list of the numbers in xs that are greater than 9, in their original order.", "tests": ["assert keep_greater_than_9([-8, 14, -11, -12]) == [14]", "assert keep_greater_than_9([]) == []", "assert keep_greater_than_9([11, -1, 15, -11, 7, 11, -5]) == [11, 15, 11]", "assert keep_greater_than_9([-5, 10, -4, 6, -14, 4, -14]) == [10]", "assert keep_greater_than_9([-8, -14, 14, -9, -6, -4, -7, 3]) == [14]"], "reference": "    return [x for x in xs if x > 9]\n"}
{"name": "add_5_to_each", "args": "xs", "doc": "Return a new list with 5 added to every number in xs.", "tests": ["assert add_5_to_each([-15, -4, -5, -7]) == [-10, 1, 0, -2]", "assert add_5_to_each([2, 3, -11, 10, -15]) == [7, 8, -6, 15, -10]", "assert add_5_to_each([-10, 6, -14, -7]) == [-5, 11, -9, -2]", "assert add_5_to_each([2, 0, 15, 4, 5, -15]) == [7, 5, 20, 9, 10, -10]", "assert add_5_to_each([8]) == [13]"], "reference": "    return [x + 5 for x in xs]\n"}
{"name": "add_10_to_each", "args": "xs", "doc": "Return a new list with 10 added to every number in xs.", "tests": ["assert add_10_to_each([-4]) == [6]", "assert add_10_to_each([-7, -8, 10, 1, 15, 15, 7]) == [3, 2, 20, 11, 25, 25, 17]", "assert add_10_to_each([]) == []", "assert add_10_to_each([-10, 11, 13]) == [0, 21, 23]", "assert add_10_to_each([-14, -2, 4, 1, -8, -7, 10]) == [-4, 8, 14, 11, 2, 3, 20]"], "reference": "    return [x + 10 for x in xs]\n"}
{"name": "add_12_to_each", "args": "xs", "doc": "Return a new list with 12 added to every number in xs.", "tests": ["assert add_12_to_each([10, -8, 12, 6]) == [22, 4, 24, 18]", "assert add_12_to_each([14, 4]) == [26, 16]", "assert add_12_to_each([7, 4, -3, 11, 5, 5, 1, -2]) == [19, 16, 9, 23, 17, 17, 13, 10]", "assert add_12_to_each([-14, -8, 5, 10, -3, -7, -11]) == [-2, 4, 17, 22, 9, 5, 1]", "assert add_12_to_each([-14, -4, 0, 12, -5, -5, -7]) == [-2, 8, 12, 24, 7, 7, 5]"], "reference": "    return [x + 12 for x in xs]\n"}
{"name": "add_13_to_each", "args": "xs", "doc": "Return a new list with 13 added to every number in xs.", "tests": ["assert add_13_to_each([14]) == [27]", "assert add_13_to_each([14, -15, 0, -8, 4]) == [27, -2, 13, 5, 17]", "assert add_13_to_each([3, 11]) == [16, 24]", "assert add_13_to_each([-8, 3]) == [5, 16]", "assert add_13_to_each([-12]) == [1]"], "reference": "    return [x + 13 for x in xs]\n"}
{"name": "multiply_each_by_4", "args": "xs", "doc": "Return a new list with every number in xs multiplied by 4.", "tests": ["assert multiply_each_by_4([-7, -2, 9, -4]) == [-28, -8, 36, -16]", "assert multiply_each_by_4([-10]) == [-40]", "assert multiply_each_by_4([4, -10]) == [16, -40]", "assert multiply_each_by_4([8, 0, 4, -14, 1]) == [32, 0, 16, -56, 4]", "assert multiply_each_by_4([-1]) == [-4]"], "reference": "    return [x * 4 for x in xs]\n"}
{"name": "multiply_each_by_8", "args": "xs", "doc": "Return a new list with every number in xs multiplied by 8.", "tests": ["assert multiply_each_by_8([15, 7, 1]) == [120, 56, 8]", "assert multiply_each_by_8([-9, 5]) == [-72, 40]", "assert multiply_each_by_8([1, 15]) == [8, 120]", "assert multiply_each_by_8([0, 0, -6]) == [0, 0, -48]", "assert multiply_each_by_8([-4, -14, 11, -13, -10, -10, 1, -11]) == [-32, -112, 88, -104, -80, -80, 8, -88]"], "reference": "    return [x * 8 for x in xs]\n"}
{"name": "multiply_each_by_10", "args": "xs", "doc": "Return a new list with every number in xs multiplied by 10.", "tests": ["assert multiply_each_by_10([-5, 6, -7, -1, 3]) == [-50, 60, -70, -10, 30]", "assert multiply_each_by_10([]) == []", "assert multiply_each_by_10([-6, -4, -7, -8, -9, 2, 5, -8]) == [-60, -40, -70, -80, -90, 20, 50, -80]", "assert multiply_each_by_10([10, -6, -12, 15, -2, -6, 13, 10]) == [100, -60, -120, 150, -20, -60, 130, 100]", "assert multiply_each_by_10([-13, 7, -9, 14]) == [-130, 70, -90, 140]"], "reference": "    return [x * 10 for x in xs]\n"}
{"name": "count_in_range_0_5", "args": "xs", "doc": "Return how many numbers in xs are between 0 and 5 inclusive.", "tests": ["assert count_in_range_0_5([-2, -4, 5, -8, -3, -7, -3]) == 1", "assert count_in_range_0_5([]) == 0", "assert count_in_range_0_5([1, 1, 3, 7]) == 3", "assert count_in_range_0_5([13, 10, -13, 0, 11, 2]) == 2", "assert count_in_range_0_5([-14, 10, -7, 13]) == 0"], "reference": "    return sum(1 for x in xs if 0 <= x <= 5)\n"}
{"name": "count_in_range_5_15", "args": "xs", "doc": "Return how many numbers in xs are between 5 and 15 inclusive.", "tests": ["assert count_in_range_5_15([8, 3, 9, 4, 6]) == 3", "assert count_in_range_5_15([-12, 2, -13, -2, -6, -1, -9]) == 0", "assert count_in_range_5_15([-15, 10, 2]) == 1", "assert count_in_range_5_15([4, 13, -7, -9, -10, 3]) == 1", "assert count_in_range_5_15([-6, -7, -7, -3, -5, 5, -8, 0]) == 1"], "reference": "    return sum(1 for x in xs if 5 <= x <= 15)\n"}
{"name": "count_char_d", "args": "s", "doc": "Return how many times the letter 'd' appears in s.", "tests": ["assert count_char_d('dance coder global') == 2", "assert count_char_d('under aaa') == 1", "assert count_char_d('export export global singing') == 0", "assert count_char_d('apple river quickly intake') == 0", "assert count_char_d('reader player') == 1"], "reference": "    return s.count('d')\n"}
{"name": "count_char_r", "args": "s", "doc": "Return how many times the letter 'r' appears in s.", "tests": ["assert count_char_r('matches apple cherry abc') == 2", "assert count_char_r('global export') == 1", "assert count_char_r('river') == 2", "assert count_char_r('station player') == 1", "assert count_char_r('aaa intake') == 0"], "reference": "    return s.count('r')\n"}
{"name": "count_char_s", "args": "s", "doc": "Return how many times the letter 's' appears in s.", "tests": ["assert count_char_s('coder nation player nation') == 0", "assert count_char_s('player') == 0", "assert count_char_s('tables') == 1", "assert count_char_s('final') == 0", "assert count_char_s('fixed') == 0"], "reference": "    return s.count('s')\n"}
{"name": "replace_a_with_o", "args": "s", "doc": "Return s with every 'a' replaced by 'o'.", "tests": ["assert replace_a_with_o('quickly fixed singing unit') == 'quickly fixed singing unit'", "assert replace_a_with_o('matches quickly') == 'motches quickly'", "assert replace_a_with_o('matches dance river') == 'motches donce river'", "assert replace_a_with_o('tables singing') == 'tobles singing'", "assert replace_a_with_o('redo cherry') == 'redo cherry'"], "reference": "    return s.replace('a', 'o')\n"}
{"name": "starts_with_re", "args": "s", "doc": "Return True if s starts with 're', otherwise False.", "tests": ["assert starts_with_re('redo') == True", "assert starts_with_re('jumped') == False", "assert starts_with_re('softly') == False", "assert starts_with_re('abc') == False", "assert starts_with_re('river') == False"], "reference": "    return s.startswith('re')\n"}
{"name": "starts_with_un", "args": "s", "doc": "Return True if s starts with 'un', otherwise False.", "tests": ["assert starts_with_un('global') == False", "assert starts_with_un('unit') == True", "assert starts_with_un('player') == False", "assert starts_with_un('abc') == False", "assert starts_with_un('redo') == False"], "reference": "    return s.startswith('un')\n"}
{"name": "starts_with_pre", "args": "s", "doc": "Return True if s starts with 'pre', otherwise False.", "tests": ["assert starts_with_pre('global') == False", "assert starts_with_pre('station') == False", "assert starts_with_pre('export') == False", "assert starts_with_pre('preview') == True", "assert starts_with_pre('unit') == False"], "reference": "    return s.startswith('pre')\n"}
{"name": "add_suffix_tion", "args": "s", "doc": "Return s followed by 'tion'.", "tests": ["assert add_suffix_tion('abc') == 'abction'", "assert add_suffix_tion('intake') == 'intaketion'", "assert add_suffix_tion('banana') == 'bananation'", "assert add_suffix_tion('player') == 'playertion'", "assert add_suffix_tion('boxes') == 'boxestion'"], "reference": "    return s + 'tion'\n"}
{"name": "repeat_4_times", "args": "s", "doc": "Return s repeated 4 times, with nothing in between.", "tests": ["assert repeat_4_times('apple') == 'appleappleappleapple'", "assert repeat_4_times('intake') == 'intakeintakeintakeintake'", "assert repeat_4_times('reader') == 'readerreaderreaderreader'", "assert repeat_4_times('tables') == 'tablestablestablestables'", "assert repeat_4_times('under') == 'underunderunderunder'"], "reference": "    return s * 4\n"}
{"name": "repeat_5_times", "args": "s", "doc": "Return s repeated 5 times, with nothing in between.", "tests": ["assert repeat_5_times('under') == 'underunderunderunderunder'", "assert repeat_5_times('apple') == 'appleappleappleappleapple'", "assert repeat_5_times('player') == 'playerplayerplayerplayerplayer'", "assert repeat_5_times('softly') == 'softlysoftlysoftlysoftlysoftly'", "assert repeat_5_times('final') == 'finalfinalfinalfinalfinal'"], "reference": "    return s * 5\n"}
{"name": "repeat_6_times", "args": "s", "doc": "Return s repeated 6 times, with nothing in between.", "tests": ["assert repeat_6_times('global') == 'globalglobalglobalglobalglobalglobal'", "assert repeat_6_times('unit') == 'unitunitunitunitunitunit'", "assert repeat_6_times('aaa') == 'aaaaaaaaaaaaaaaaaa'", "assert repeat_6_times('jumped') == 'jumpedjumpedjumpedjumpedjumpedjumped'", "assert repeat_6_times('under') == 'underunderunderunderunderunder'"], "reference": "    return s * 6\n"}
{"name": "first_2_chars", "args": "s", "doc": "Return the first 2 characters of s, or all of s if it is shorter.", "tests": ["assert first_2_chars('redo') == 're'", "assert first_2_chars('dance') == 'da'", "assert first_2_chars('nation') == 'na'", "assert first_2_chars('fixed') == 'fi'", "assert first_2_chars('rain') == 'ra'"], "reference": "    return s[:2]\n"}
