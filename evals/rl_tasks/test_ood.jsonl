{"name": "ends_with_al", "args": "s", "doc": "Return True if s ends with 'al', otherwise False.", "tests": ["assert ends_with_al('boxes') == False", "assert ends_with_al('rain') == False", "assert ends_with_al('player') == False", "assert ends_with_al('apple') == False", "assert ends_with_al('final') == True"], "reference": "    return s.endswith('al')\n"}
