{"name": "adjacent_differences", "args": "xs", "doc": "Return the list of differences between neighbours: [xs[1] - xs[0], xs[2] - xs[1], ...].", "tests": ["assert adjacent_differences([-8, 12, -8, 2, -9, -2, -2]) == [20, -20, 10, -11, 7, 0]", "assert adjacent_differences([11, 5]) == [-6]", "assert adjacent_differences([]) == []", "assert adjacent_differences([-11, 4]) == [15]", "assert adjacent_differences([8, -14]) == [-22]"], "reference": "    return [b - a for a, b in zip(xs, xs[1:])]\n"}
{"name": "ends_with_ing", "args": "s", "doc": "Return True if s ends with 'ing', otherwise False.", "tests": ["assert ends_with_ing('aaa') == False", "assert ends_with_ing('singing') == True", "assert ends_with_ing('nation') == False", "assert ends_with_ing('apple') == False", "assert ends_with_ing('banana') == False"], "reference": "    return s.endswith('ing')\n"}
{"name": "ends_with_ed", "args": "s", "doc": "Return True if s ends with 'ed', otherwise False.", "tests": ["assert ends_with_ed('apple') == False", "assert ends_with_ed('jumped') == True", "assert ends_with_ed('export') == False", "assert ends_with_ed('river') == False", "assert ends_with_ed('tables') == False"], "reference": "    return s.endswith('ed')\n"}
