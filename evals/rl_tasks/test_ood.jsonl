{"name": "last_4_chars", "args": "s", "doc": "Return the last 4 characters of s, or all of s if it is shorter.", "tests": ["assert last_4_chars('matches') == 'ches'", "assert last_4_chars('coder') == 'oder'", "assert last_4_chars('nation') == 'tion'", "assert last_4_chars('cherry') == 'erry'", "assert last_4_chars('intake') == 'take'"], "reference": "    return s[-4:]\n"}
{"name": "last_5_chars", "args": "s", "doc": "Return the last 5 characters of s, or all of s if it is shorter.", "tests": ["assert last_5_chars('intake') == 'ntake'", "assert last_5_chars('debug') == 'debug'", "assert last_5_chars('dance') == 'dance'", "assert last_5_chars('quickly') == 'ickly'", "assert last_5_chars('unit') == 'unit'"], "reference": "    return s[-5:]\n"}
{"name": "count_spaces", "args": "s", "doc": "Return how many spaces s contains.", "tests": ["assert count_spaces('preview') == 0", "assert count_spaces('redo boxes') == 1", "assert count_spaces('rain final abc abc') == 3", "assert count_spaces('fixed preview preview station') == 3", "assert count_spaces('boxes player cherry intake') == 3"], "reference": "    return s.count(' ')\n"}
{"name": "last_word", "args": "s", "doc": "Return the last word of s, where words are separated by spaces.", "tests": ["assert last_word('coder aaa softly') == 'softly'", "assert last_word('nation player') == 'player'", "assert last_word('unit rain jumped aaa') == 'aaa'", "assert last_word('under final aaa') == 'aaa'", "assert last_word('cherry export banana softly') == 'softly'"], "reference": "    return s.split()[-1]\n"}
