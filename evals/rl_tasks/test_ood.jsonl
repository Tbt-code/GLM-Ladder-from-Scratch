{"name": "ends_with_es", "args": "s", "doc": "Return True if s ends with 'es', otherwise False.", "tests": ["assert ends_with_es('player') == False", "assert ends_with_es('matches') == True", "assert ends_with_es('jumped') == False", "assert ends_with_es('redo') == False", "assert ends_with_es('aaa') == False"], "reference": "    return s.endswith('es')\n"}
