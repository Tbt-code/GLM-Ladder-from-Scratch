{"name": "keep_less_than_minus_5", "args": "xs", "doc": "Return a list of the numbers in xs that are less than -5, in their original order.", "tests": ["assert keep_less_than_minus_5([7, 4, -6]) == [-6]", "assert keep_less_than_minus_5([-6, 9]) == [-6]", "assert keep_less_than_minus_5([-6, -2, 11, -2, 2, -2]) == [-6]", "assert keep_less_than_minus_5([-13, -3, -3]) == [-13]", "assert keep_less_than_minus_5([12, -9, 4, 2, 8]) == [-9]"], "reference": "    return [x for x in xs if x < -5]\n"}
{"name": "sum_greater_than_minus_5", "args": "xs", "doc": "Return the sum of the numbers in the list xs that are greater than -5.", "tests": ["assert sum_greater_than_minus_5([-7, 9, -5, 7, -8, 8, 13]) == 37", "assert sum_greater_than_minus_5([2, -13, 12, -9, 8]) == 22", "assert sum_greater_than_minus_5([-10, -13, -1, -10]) == -1", "assert sum_greater_than_minus_5([8, 9, -8]) == 17", "assert sum_greater_than_minus_5([4, -2, -1, 11]) == 12"], "reference": "    return sum(x for x in xs if x > -5)\n"}
{"name": "keep_less_than_minus_4", "args": "xs", "doc": "Return a list of the numbers in xs that are less than -4, in their original order.", "tests": ["assert keep_less_than_minus_4([13]) == []", "assert keep_less_than_minus_4([0, -12, -5, 14, -4, -10]) == [-12, -5, -10]", "assert keep_less_than_minus_4([14, -14, -13]) == [-14, -13]", "assert keep_less_than_minus_4([-2, -1]) == []", "assert keep_less_than_minus_4([]) == []"], "reference": "    return [x for x in xs if x < -4]\n"}
